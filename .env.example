ENV=dev
PROJECT_NAME=agentic_web_starter
PROJECT_VERSION=0.1.0
PROJECT_DESCRIPTION="An agentic workflow automation application."
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
BASE_PATH=/agentic_web_starter

OPENROUTER_API_KEY=""

# Working directory for logs and Hugging Face model data (default: current directory).
WORKING_DIR=

# Qdrant collection base name (default: agentic_web_starter).
COLLECTION_NAME=

# Hugging Face cache home (default: WORKING_DIR/hf).
HF_HOME=

# Set to true to enable Qdrant retrieval.
USE_QDRANT=true
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_PROTOCOL=http

# LangSmith tracing (optional).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=workflow-agent
