ENV=dev
PROJECT_NAME=workflow-agent
PROJECT_VERSION=0.1.0
PROJECT_DESCRIPTION="An agentic workflow automation application."
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
BASE_PATH=/workflow-agent

OPENROUTER_API_KEY=""
MODEL_NAME=""
# Working directory for logs and Hugging Face model data (default: current directory).
WORKING_DIR=

# Hugging Face cache home (default: WORKING_DIR/PROJECT_NAME/hf).
HF_HOME=

# Qdrant settings
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=workflow-sop
QDRANT_API_KEY=""

# LangSmith tracing (optional).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=workflow-sop

# Postgres settings
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:5432/workflow_agent"

# Persistence mode
CHECKPOINTER_TYPE="memory"